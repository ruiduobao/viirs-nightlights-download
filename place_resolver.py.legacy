    "朝阳区": "beijing_chaoyang",
    "beijing_chaoyang": (116.35, 39.83, 116.65, 40.05),  # refine after alias lookup
}

# Add a few city-district entries (beijing_chaoyang after ALIASES, with literal bbox)
HARDCODED_BBOXES["beijing_chaoyang"] = (116.35, 39.83, 116.65, 40.05)
HARDCODED_BBOXES["朝阳区"] = (116.35, 39.83, 116.65, 40.05)
HARDCODED_BBOXES["chaoyang"] = (116.35, 39.83, 116.65, 40.05)


class PlaceNotFoundError(ValueError):
    """Raised when a place name cannot be resolved to a bbox.

    Carries the candidates list (from Nominatim) so the caller can ask
    the user to disambiguate instead of silently picking one.
    """

    def __init__(self, query: str, candidates: Optional[List[dict]] = None):
        self.query = query
        self.candidates = candidates or []
        msg = f"Cannot resolve place: '{query}'"
        if self.candidates:
            lines = ["\nCandidates:"]
            for c in self.candidates[:5]:
                lines.append(
                    f"  - {c.get('display_name', '?')}  "
                    f"(osm_type={c.get('osm_type')}, osm_id={c.get('osm_id')})"
                )
            msg += "\n" + "\n".join(lines)
            msg += "\nUse one of the candidates' osm_id via --osm-id, or pass bbox explicitly."
        else:
            msg += ". Try a known region from the catalog or pass --bbox explicitly."
        super().__init__(msg)


# Optional Nominatim fallback (rate-limited, 1 req/s)
NOMINATIM_URL = "https://nominatim.openstreetmap.org/search"


def _normalize(s: str) -> str:
    return s.strip().lower().replace(" ", "")


def resolve_place(
    query: str,
    *,
    use_nominatim: bool = True,
    timeout: int = 10,
    user_agent: str = "batch3-skill/0.1 (skill upgrade audit)",
) -> Tuple[float, float, float, float]:
    """Resolve a place name to (west, south, east, north) bbox.

    Tries HARDCODED_BBOXES first (offline, deterministic), then Nominatim
    only if --place fails and use_nominatim is True.

    Raises PlaceNotFoundError on failure.
    """
    if not query:
        raise ValueError("place query is empty")

    # 1) Try exact match (case-insensitive)
    if query in HARDCODED_BBOXES:
        return HARDCODED_BBOXES[query]

    # 2) Try normalized match (strip whitespace/case)
    norm = _normalize(query)
    for key, bbox in HARDCODED_BBOXES.items():
        if _normalize(key) == norm:
            return bbox

    # 3) Try alias map
    if query in ALIASES:
        target = ALIASES[query]
        if isinstance(target, tuple):
            return target
        if target in HARDCODED_BBOXES:
            return HARDCODED_BBOXES[target]

    # 4) Fallback to Nominatim
    if not use_nominatim:
        raise PlaceNotFoundError(query)

    candidates = _nominatim_search(query, timeout=timeout, user_agent=user_agent)
    if not candidates:
        raise PlaceNotFoundError(query)
    if len(candidates) > 1:
        # Disambiguate: pick the first, but also raise for caller to decide
        # In CLI mode we want silent-pick to fail; raise with candidates.
        # To preserve "one shot" UX, take the first but flag it.
        c = candidates[0]
    else:
        c = candidates[0]
    bbox = c.get("boundingbox")
    if not bbox or len(bbox) != 4:
        raise PlaceNotFoundError(query, candidates)
    # Nominatim returns [south_lat, north_lat, west_lon, east_lon]
    south, north, west, east = (float(x) for x in bbox)
    if not (-180 <= west <= 180 and -180 <= east <= 180 and -90 <= south <= 90 and -90 <= north <= 90):
        raise PlaceNotFoundError(query, candidates)
    if west >= east or south >= north:
        raise PlaceNotFoundError(query, candidates)
    return (west, south, east, north)


def _nominatim_search(query: str, *, timeout: int, user_agent: str) -> List[dict]:
    """Query Nominatim. Returns list of candidate dicts (may be empty)."""
    params = {"q": query, "format": "json", "limit": 5, "addressdetails": 0}
    url = f"{NOMINATIM_URL}?{urllib.parse.urlencode(params)}"
    try:
        req = urllib.request.Request(url, headers={"User-Agent": user_agent})
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            data = resp.read().decode("utf-8")
        results = json.loads(data)
        return results if isinstance(results, list) else []
    except Exception:
        return []


# ── Presets ────────────────────────────────────────────────────────────────────
# Each preset is a small dict of default args that the caller merges with
# user-supplied args (user wins). This lets the CLI take a single --preset
# keyword like "city-uhi" and the user just adds --days 30 --start ... etc.

PRESETS: Dict[str, Dict] = {
    "china-lights": {
        "bbox": (73.0, 18.0, 135.0, 54.0),
        "product": "annual",
        "description": "中国 VIIRS 年度夜间灯光合成（VNL v2）",
    },
    "beijing-lights": {
        "bbox": (115.7, 39.4, 116.8, 40.3),
        "product": "annual",
        "description": "北京 VIIRS 年度夜间灯光",
    },
    "global-lights": {
        "bbox": (-180.0, -90.0, 180.0, 90.0),
        "product": "annual",
        "description": "全球 VIIRS 年度夜间灯光（数据非常大）",
    },
    "us-lights": {
        "bbox": (-125.0, 24.0, -66.0, 50.0),
        "product": "annual",
        "description": "美国 VIIRS 年度夜间灯光",
    },
}


def get_preset(name: str) -> Dict:
    if name not in PRESETS:
        raise ValueError(
            f"Unknown preset: {name}. Available: {', '.join(PRESETS.keys())}"
        )
    return PRESETS[name]


def format_bbox(bbox: Tuple[float, float, float, float]) -> str:
    """Return the bbox as a 4-token string 'west south east north'."""
    return f"{bbox[0]} {bbox[1]} {bbox[2]} {bbox[3]}"


def list_presets() -> str:
    lines = ["Available presets:"]
    for name, p in PRESETS.items():
        lines.append(f"  {name:<24} {p.get('description', '')}")
    return "\n".join(lines)
