"""place_resolver.py — Common region/place → bbox resolver.

Self-contained, no third-party deps. Used by all 8 skills in batch3 to bridge
natural-language place names (e.g. "北京市", "长江流域", "中国") to the bbox
format expected by STAC / CMR / FIRMS / EOG / etc.

Hierarchy:
  1. Exact match in HARDCODED_BBOXES (offline, fast, no network)
  2. Alias / fuzzy match in HARDCODED_BBOXES
  3. Live Nominatim search (1 req/s rate limit, may rate-limit in batch)

When a place is ambiguous, raises PlaceNotFoundError with the candidate list
so the user can disambiguate, instead of silently picking one.
"""

from __future__ import annotations

import json
import time
import urllib.parse
import urllib.request
from typing import Dict, List, Optional, Tuple

# Bbox format: (west, south, east, north), longitude/latitude in WGS84
